# Database credentials
POSTGRES_DB=app
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# app-server
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@app-db:5432/${POSTGRES_DB}
RUST_BACKTRACE=1
RUST_LOG=debug

# app-front
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
DOCKER_ENV=true
NODE_ENV=development
